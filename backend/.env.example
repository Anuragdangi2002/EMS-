PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ems_db?schema=public"

# JWT Secrets (min 32 characters)
JWT_ACCESS_SECRET="your_jwt_access_token_secret_minimum_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_token_secret_minimum_32_characters"

# JWT Expirations
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100

# Initial Admin Provisioning (Seeding)
INITIAL_HR_EMAIL="hr@example.com"
INITIAL_HR_PASSWORD="change-me-securely"
INITIAL_DIRECTOR_EMAIL="director@example.com"
INITIAL_DIRECTOR_PASSWORD="change-me-securely"
